# ---- Build-time (Cloudflare Pages → Settings → Variables, "Production" + "Preview") ----
# Public half of the access-pass key (node scripts/gen-pass-key.mjs). Without it the app builds with billing OFF.
VITE_PASS_PUBLIC_JWK=
# Optional: Google sign-in button (OAuth client ID, type "Web application", origin = your domain)
VITE_GOOGLE_CLIENT_ID=
# Set to "off" to build without the account gate (self-hosting / old e2e flows)
VITE_BILLING=

# ---- Runtime secrets for Pages Functions (Settings → Variables → Encrypt) ----
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/pikul?sslmode=require
RESEND_API_KEY=re_xxx
MAIL_FROM=Pikul <masuk@pikul.id>
PASS_PRIVATE_JWK=
GOOGLE_CLIENT_ID=
APP_ORIGIN=https://pikul.pages.dev
# Emails allowed into /admin (comma-separated, lower-case). Empty = admin console closed.
ADMIN_EMAILS=
# Temporary (ADR-019): "1" opens /admin WITHOUT sign-in. Anyone with the link can change prices and promos. Remove when email sign-in works.
# ADMIN_OPEN=1
# Local `wrangler pages dev` only: memory DB + codes printed to the log. NEVER set in production.
# DEV_MODE=1
