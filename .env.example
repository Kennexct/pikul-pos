# Pikul on Vercel + Neon (ADR-022). Full steps: docs/runbooks/deploy-vercel-neon.md
# Set these in Vercel → Project → Settings → Environment Variables (Production + Preview).

# ---- Build-time (baked into the app; redeploy after a change) ----
# Public half of the access-pass key (node scripts/gen-pass-key.mjs). Without it the app builds with no sign-in.
VITE_PASS_PUBLIC_JWK=
# Optional: Google sign-in button for existing accounts (OAuth client ID, type "Web application", origin = your domain)
VITE_GOOGLE_CLIENT_ID=
# Set to "off" to build without the account gate (self-hosting / old e2e flows)
VITE_BILLING=

# ---- Runtime (mark as Sensitive) ----
# Neon connection string (Neon console → Connect). Run db/neon-setup.sql on this database first.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Private half of the access-pass key (node scripts/gen-pass-key.mjs)
PASS_PRIVATE_JWK=
# The site's public address, no trailing slash
APP_ORIGIN=https://pikul.vercel.app
# /admin password (ADR-020). At least 12 characters (use a long passphrase). Empty = admin console closed.
ADMIN_PASSWORD=

# ---- Optional ----
# Email for "Lupa kata sandi" codes (ADR-023). Both empty = no email; the admin makes temporary passwords instead.
RESEND_API_KEY=
MAIL_FROM=Pikul <masuk@pikul.id>
# Google sign-in (server side, same client ID as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Local only (scripts/vercel-local.mjs): memory DB, no Neon. Ignored when VERCEL_ENV=production. NEVER set on Vercel.
# DEV_MODE=1
