{
  "name": "pikul",
  "private": true,
  "version": "0.22.0",
  "type": "module",
  "description": "Offline-first web POS for Indonesian UMKM and street food sellers",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && tsc -p tsconfig.vercel.json && vite build",
    "build:vercel": "npm run build && node scripts/vercel-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json && tsc -p tsconfig.vercel.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "node scripts/i18n-keys.mjs",
    "i18n:scan": "node scripts/i18n-scan.mjs",
    "landing": "python3 scripts/landing/build.py static",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2026-11-01"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@neondatabase/serverless": "^1.2.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "jose": "^6.2.18",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.11.0",
    "write-excel-file": "^4.1.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "read-excel-file": "^9.3.17",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
